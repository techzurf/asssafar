# Supabase Configuration for As-Safar Admin Authentication (Phase 2)
# Obtain these from your Supabase Project Settings -> API:
# 1. Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Public Publishable / Anon Key (Safe for frontend exposure, subject to RLS)
# DO NOT USE SERVICE_ROLE KEY HERE!
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# 3. Optional Admin Authorization Overrides (Comma-separated admin email list)
# Used in conjunction with Supabase Auth app_metadata.role === 'admin'
VITE_ADMIN_EMAILS=admin@as-safar.com,manager@as-safar.com
